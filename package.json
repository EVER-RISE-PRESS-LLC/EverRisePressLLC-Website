{
  "name": "everrisepress-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint",
    "test:blog": "node --test --experimental-strip-types scripts/blog.test.mjs",
    "check:blog": "node scripts/blog-check.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "upload": "wrangler versions upload --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply everrisepress-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply everrisepress-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "wrangler d1 execute everrisepress-db --file ./src/lib/db/seed.sql",
    "db:seed:partners:local": "wrangler d1 execute everrisepress-db --local --file ./src/lib/db/seed-referral-partners.sql",
    "db:seed:partners:remote": "wrangler d1 execute everrisepress-db --remote --file ./src/lib/db/seed-referral-partners.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "test:admin": "node --test --experimental-strip-types scripts/admin-articles.test.mjs scripts/admin-article-api.test.mjs scripts/admin-login-api.test.mjs scripts/admin-readers-referrals.test.mjs scripts/admin-draft-recovery.test.mjs && node scripts/admin-catalog-media.test.mjs",
    "test:public": "node --test --experimental-strip-types scripts/blog.test.mjs scripts/privacy-access.test.mjs scripts/public-content.test.mjs scripts/tracking-page.test.mjs scripts/posthog-loading.test.mjs scripts/meta-loading.test.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@jdevalk/seo-graph-core": "0.7.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@next/third-parties": "16.4.1",
    "@radix-ui/react-label": "^2.1.15",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.9",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.418.17",
    "posthog-js-lite": "^4.10.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.8.0",
    "sanitize-html": "^2.18.1",
    "schema-dts": "^2.0.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.6",
    "vinext": "1.3.1",
    "react-server-dom-webpack": "19.3.1",
    "@vinext/cloudflare": "1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.148.0",
    "vite": "8.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-rsc": "0.5.38",
    "@cloudflare/vite-plugin": "1.65.0"
  },
  "overrides": {
    "posthog-js": {
      "dompurify": "3.4.17"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "packageManager": "npm@11.16.0"
}
